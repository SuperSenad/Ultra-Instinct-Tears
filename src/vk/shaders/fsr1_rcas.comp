// FSR 1 RCAS (robust contrast-adaptive sharpening) after EASU (src/vk/present_fsr.c): 5 taps, the lobe limited so it
// never clips. A GLSL port of ffx_fsr1.h (AMD FidelityFX Super Resolution 1.0, MIT; the full notice is in
// fsr1_easu.comp), following SkyboundTOTK's WGSL port (a64-kit/gpu/render/rx_present_fx.cpp, MIT).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D src;           // EASU's output
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    vec4 rcas;     // x: sharpness as exp2(-stops) (1 the sharpest)
    ivec4 crop;    // unused here (layout shared with EASU)
    ivec2 size;    // src's and dst's size
} p;

vec3 ld(ivec2 q) { return texelFetch(src, clamp(q, ivec2(0), p.size - 1), 0).rgb; }

void main() {
    ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
    if (ip.x >= p.size.x || ip.y >= p.size.y) return;
    vec3 b = ld(ip + ivec2(0, -1));
    vec3 d = ld(ip + ivec2(-1, 0));
    vec3 e = ld(ip);
    vec3 f = ld(ip + ivec2(1, 0));
    vec3 h = ld(ip + ivec2(0, 1));
    vec3 mn4 = min(min(b, d), min(f, h));
    vec3 mx4 = max(max(b, d), max(f, h));
    vec3 hitMin = min(mn4, e) / max(4.0 * mx4, vec3(1e-5));   // as ffx_fsr1.h: the centre counts for the limits
    vec3 hitMax = (1.0 - max(mx4, e)) / min(4.0 * mn4 - 4.0, vec3(-1e-5));
    vec3 lobeRGB = max(-hitMin, hitMax);
    float lobe = max(-0.1875, min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * p.rcas.x;
    imageStore(dst, ip, vec4((lobe * (b + d + h + f) + e) / (4.0 * lobe + 1.0), 1.0));
}
