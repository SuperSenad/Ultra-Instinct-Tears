# The source folder holds no game data. Everything made from the game lives in the game folder (a builder package
# unpacked elsewhere, tools/deploy.py); the patterns below are a safety net for what must never be committed.

# The user's own files from their console: never commit
Game/
Keys/
Firmware/
*.nsp
*.nsz
*.xci
*.xcz
*.nca
*.nso
*.nro
*.keys
*.tik
*.bfttf

# Development only, not in the repository or a release: local tools, reference checkouts, .NET caches, builds of
# development tools, release packages
/dev-local/
/dist/

# A game folder's own (tools/setup.py), should one ever be made inside the source folder
/game/
/data/
/build/
/userdata/
/diag/
/deps/
/ultrainstincttears.cfg
/UltraInstinctTears.exe
/UltraInstinctTearsLauncher.exe
# the names before the rename to Ultra Instinct Tears (setup.py leaves them in place)
/ultratears.cfg
/UltraTears.exe
/UltraTearsLauncher.exe
/setup-files.txt

# Former development layout (kept ignored until removed)
/work/
/refs/
/user-data/
.ninja_*

# Local environments and build state
.venv/
__pycache__/
third_party/maxwell_shader/src/*/bin/
third_party/maxwell_shader/src/*/obj/
third_party/shader_translator/bin/
third_party/shader_translator/obj/
third_party/totk_xlate/

# Made in a game folder by the game, the launcher and the update / report / mod tools: never commit
/logs/
/updates/
/reports/
/mods/
/amiibo/
/saves/
/VERSION.txt
/launcher-crash.txt
*.log
*.dmp
*.pdb
# Amiibo and other console dumps (raw NTAG215 files); release packages built by hand
*.bin
*.nfc
*.amiibo
UltraInstinctTears-src*.zip
UltraInstinctTears-report*.zip
# Editors and OS clutter
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
